<script>
    let modoSimuladorAtual = '2D';
    let codigoFoiCopiado = false;

    // VARIÁVEIS DA ANIMAÇÃO DO SIMULADOR
    let animandoSimulador = false;
    let tempoAnimacaoSim = 0;
    let idAnimacaoSim = null;
    let velocidadeSimulador = 2;
    let trajetoSimulacaoTotal = [];

    let listaFurosCustom = [
        {x: 60, y: 0, t: 5, diam: 8.0, rpm: 1800, avanco: 220, zFinal: 20, qPasse: 3},
        {x: 0, y: 60, t: 5, diam: 8.0, rpm: 1800, avanco: 220, zFinal: 20, qPasse: 3},
        {x: -60, y: 0, t: 8, diam: 10.5, rpm: 1500, avanco: 180, zFinal: 25, qPasse: 4},
        {x: 0, y: -60, t: 8, diam: 10.5, rpm: 1500, avanco: 180, zFinal: 25, qPasse: 4}
    ];

    let listaBrocasAlivio = [
        {t: 3, diam: 6.0, rpm: 2200, avanco: 250, q: 3.0},
        {t: 4, diam: 12.0, rpm: 1600, avanco: 180, q: 4.0}
    ];

    // --- LÓGICA DO SIMULADOR INTEGRADO 2D / 3D E CAMINHO DA FERRAMENTA ---
    function definirModoSimulador(modo) {
        modoSimuladorAtual = modo;
        document.getElementById('btnSim2D').classList.toggle('active', modo === '2D');
        document.getElementById('btnSim3D').classList.toggle('active', modo === '3D');
        atualizarSimulador();
    }

    function alternarAcabamentoContorno() {
        const opcao = document.getElementById('c_execAcab').value;
        const bloco = document.getElementById('blocoAcabamentoContorno');
        if (opcao === 'NAO') {
            bloco.style.display = 'none';
        } else {
            bloco.style.display = 'block';
        }
    }

    function alternarAnimacaoSimulador() {
        animandoSimulador = !animandoSimulador;
        const btn = document.getElementById('btnPlaySim');
        if (animandoSimulador) {
            btn.innerHTML = '⏸ Pause';
            loopAnimacaoSimulador();
        } else {
            btn.innerHTML = '▶ Play';
            if (idAnimacaoSim) cancelAnimationFrame(idAnimacaoSim);
        }
    }

    function resetarAnimacaoSimulador() {
        tempoAnimacaoSim = 0;
        animandoSimulador = false;
        document.getElementById('btnPlaySim').innerHTML = '▶ Play';
        document.getElementById('simProgressSlider').value = 0;
        document.getElementById('simProgressTxt').innerText = '0%';
        if (idAnimacaoSim) cancelAnimationFrame(idAnimacaoSim);
        atualizarSimulador();
    }

    function aoMudarProgressoSlider(val) {
        tempoAnimacaoSim = parseFloat(val) / 100;
        document.getElementById('simProgressTxt').innerText = Math.round(val) + '%';
        atualizarSimulador();
    }

    function alterarVelocidadeSimulador(v) {
        velocidadeSimulador = parseFloat(v);
    }

    function loopAnimacaoSimulador() {
        if (!animandoSimulador) return;

        tempoAnimacaoSim += 0.002 * velocidadeSimulador;
        if (tempoAnimacaoSim > 1.0) {
            tempoAnimacaoSim = 1.0;
            animandoSimulador = false;
            document.getElementById('btnPlaySim').innerHTML = '▶ Play';
        }

        let pct = Math.round(tempoAnimacaoSim * 100);
        document.getElementById('simProgressSlider').value = pct;
        document.getElementById('simProgressTxt').innerText = pct + '%';

        atualizarSimulador();

        if (animandoSimulador) {
            idAnimacaoSim = requestAnimationFrame(loopAnimacaoSimulador);
        }
    }

    function construirTrajetoSimulacao() {
        trajetoSimulacaoTotal = [];

        const brutoX = parseFloat(document.getElementById('multi_brutoX').value) || 250;
        const brutoY = parseFloat(document.getElementById('multi_brutoY').value) || 250;

        // 1. FACEAMENTO
        if (document.getElementById('chk_faceamento').checked) {
            const fDiam = parseFloat(document.getElementById('f_diam').value) || 70;
            const zFinal = parseFloat(document.getElementById('f_zFinal').value) || -1;
            const passoY = fDiam * 0.6;
            let yAtual = -brutoY / 2;
            let dir = true;

            while (yAtual <= brutoY / 2) {
                let xStart = dir ? -brutoX / 2 - fDiam / 2 : brutoX / 2 + fDiam / 2;
                let xEnd = dir ? brutoX / 2 + fDiam / 2 : -brutoX / 2 - fDiam / 2;

                trajetoSimulacaoTotal.push({ x: xStart, y: yAtual, z: zFinal, diam: fDiam, cor: '#00adb5' });
                trajetoSimulacaoTotal.push({ x: xEnd, y: yAtual, z: zFinal, diam: fDiam, cor: '#00adb5' });

                yAtual += passoY;
                dir = !dir;
            }
        }

        // 2. CONTORNO (Desbaste + Acabamento Opcional)
        if (document.getElementById('chk_contorno').checked) {
            const cDiam = parseFloat(document.getElementById('c_diamDesb').value) || 32;
            const cZFinal = -Math.abs(parseFloat(document.getElementById('c_zFinal').value) || 12);
            const sobremetal = parseFloat(document.getElementById('c_sobremetal').value) || 0.3;

            let xMin = -brutoX / 2 - sobremetal; let xMax = brutoX / 2 + sobremetal;
            let yMin = -brutoY / 2 - sobremetal; let yMax = brutoY / 2 + sobremetal;

            // Desbaste
            trajetoSimulacaoTotal.push({ x: xMin, y: yMin, z: cZFinal, diam: cDiam, cor: '#a6e3a1' });
            trajetoSimulacaoTotal.push({ x: xMax, y: yMin, z: cZFinal, diam: cDiam, cor: '#a6e3a1' });
            trajetoSimulacaoTotal.push({ x: xMax, y: yMax, z: cZFinal, diam: cDiam, cor: '#a6e3a1' });
            trajetoSimulacaoTotal.push({ x: xMin, y: yMax, z: cZFinal, diam: cDiam, cor: '#a6e3a1' });
            trajetoSimulacaoTotal.push({ x: xMin, y: yMin, z: cZFinal, diam: cDiam, cor: '#a6e3a1' });

            // Acabamento
            if (document.getElementById('c_execAcab').value === 'SIM') {
                const cDiamAcab = parseFloat(document.getElementById('c_diamAcab').value) || 20;
                let xMinA = -brutoX / 2; let xMaxA = brutoX / 2;
                let yMinA = -brutoY / 2; let yMaxA = brutoY / 2;

                trajetoSimulacaoTotal.push({ x: xMinA, y: yMinA, z: cZFinal, diam: cDiamAcab, cor: '#00adb5' });
                trajetoSimulacaoTotal.push({ x: xMaxA, y: yMinA, z: cZFinal, diam: cDiamAcab, cor: '#00adb5' });
                trajetoSimulacaoTotal.push({ x: xMaxA, y: yMaxA, z: cZFinal, diam: cDiamAcab, cor: '#00adb5' });
                trajetoSimulacaoTotal.push({ x: xMinA, y: yMaxA, z: cZFinal, diam: cDiamAcab, cor: '#00adb5' });
                trajetoSimulacaoTotal.push({ x: xMinA, y: yMinA, z: cZFinal, diam: cDiamAcab, cor: '#00adb5' });
            }
        }

        // 3. MATRIZ DE ILHAS
        if (document.getElementById('chk_matriz').checked) {
            const cols = parseInt(document.getElementById('m_colunas').value) || 1;
            const lins = parseInt(document.getElementById('m_linhas').value) || 1;
            const tX = parseFloat(document.getElementById('m_tamX').value) || 40;
            const tY = parseFloat(document.getElementById('m_tamY').value) || 40;
            const canal = parseFloat(document.getElementById('m_canal').value) || 20;
            const mDiam = parseFloat(document.getElementById('m_diam').value) || 12;
            const mZFinal = -Math.abs(parseFloat(document.getElementById('m_zFinal').value) || 12);

            const totX = (cols * tX) + ((cols - 1) * canal);
            const totY = (lins * tY) + ((lins - 1) * canal);
            const startX = -(totX / 2) + (tX / 2);
            const startY = -(totY / 2) + (tY / 2);

            for (let l = 0; l < lins; l++) {
                for (let c = 0; c < cols; c++) {
                    let posX = startX + (c * (tX + canal));
                    let posY = startY + (l * (tY + canal));
                    let minX = posX - tX / 2; let maxX = posX + tX / 2;
                    let minY = posY - tY / 2; let maxY = posY + tY / 2;

                    trajetoSimulacaoTotal.push({ x: minX, y: minY, z: mZFinal, diam: mDiam, cor: '#cba6f7' });
                    trajetoSimulacaoTotal.push({ x: maxX, y: minY, z: mZFinal, diam: mDiam, cor: '#cba6f7' });
                    trajetoSimulacaoTotal.push({ x: maxX, y: maxY, z: mZFinal, diam: mDiam, cor: '#cba6f7' });
                    trajetoSimulacaoTotal.push({ x: minX, y: maxY, z: mZFinal, diam: mDiam, cor: '#cba6f7' });
                    trajetoSimulacaoTotal.push({ x: minX, y: minY, z: mZFinal, diam: mDiam, cor: '#cba6f7' });
                }
            }
        }

        // 4. LISTA DE FUROS
        if (document.getElementById('chk_lista_furos').checked) {
            listaFurosCustom.forEach(f => {
                trajetoSimulacaoTotal.push({ x: f.x, y: f.y, z: 5, diam: f.diam, cor: '#f38ba8' });
                trajetoSimulacaoTotal.push({ x: f.x, y: f.y, z: -f.zFinal, diam: f.diam, cor: '#f38ba8' });
                trajetoSimulacaoTotal.push({ x: f.x, y: f.y, z: 5, diam: f.diam, cor: '#f38ba8' });
            });
        }

        // 5. CAVIDADE E ALÍVIO
        if (document.getElementById('chk_cavidade').checked) {
            const dimX = parseFloat(document.getElementById('cav_dimX').value) || 100;
            const dimY = parseFloat(document.getElementById('cav_dimY').value) || 60;
            const execAlivio = document.getElementById('cav_execAlivio').checked;
            const offX = parseFloat(document.getElementById('cav_alivioOffX').value) || 0;
            const offY = parseFloat(document.getElementById('cav_alivioOffY').value) || 0;
            const cavDiam = parseFloat(document.getElementById('cav_fresaDiam').value) || 16;
            const cavZFinal = -Math.abs(parseFloat(document.getElementById('cav_zFinal').value) || 15);

            let centros = obterCentrosCavidades();

            centros.forEach(cnt => {
                if (execAlivio && listaBrocasAlivio.length > 0) {
                    let b = listaBrocasAlivio[0];
                    trajetoSimulacaoTotal.push({ x: cnt.x + offX, y: cnt.y + offY, z: 5, diam: b.diam, cor: '#f9e2af' });
                    trajetoSimulacaoTotal.push({ x: cnt.x + offX, y: cnt.y + offY, z: cavZFinal, diam: b.diam, cor: '#f9e2af' });
                    trajetoSimulacaoTotal.push({ x: cnt.x + offX, y: cnt.y + offY, z: 5, diam: b.diam, cor: '#f9e2af' });
                }

                let minX = cnt.x - dimX / 2 + cavDiam / 2;
                let maxX = cnt.x + dimX / 2 - cavDiam / 2;
                let minY = cnt.y - dimY / 2 + cavDiam / 2;
                let maxY = cnt.y + dimY / 2 - cavDiam / 2;

                trajetoSimulacaoTotal.push({ x: minX, y: minY, z: cavZFinal, diam: cavDiam, cor: '#89dceb' });
                trajetoSimulacaoTotal.push({ x: maxX, y: minY, z: cavZFinal, diam: cavDiam, cor: '#89dceb' });
                trajetoSimulacaoTotal.push({ x: maxX, y: maxY, z: cavZFinal, diam: cavDiam, cor: '#89dceb' });
                trajetoSimulacaoTotal.push({ x: minX, y: maxY, z: cavZFinal, diam: cavDiam, cor: '#89dceb' });
                trajetoSimulacaoTotal.push({ x: minX, y: minY, z: cavZFinal, diam: cavDiam, cor: '#89dceb' });
            });
        }
    }

    function obterPontoAtualAnimacao() {
        if (trajetoSimulacaoTotal.length === 0) return null;
        if (trajetoSimulacaoTotal.length === 1) return trajetoSimulacaoTotal[0];

        let totalPontos = trajetoSimulacaoTotal.length - 1;
        let indiceExato = tempoAnimacaoSim * totalPontos;
        let idx1 = Math.floor(indiceExato);
        let idx2 = Math.min(idx1 + 1, totalPontos);
        let t = indiceExato - idx1;

        let p1 = trajetoSimulacaoTotal[idx1];
        let p2 = trajetoSimulacaoTotal[idx2];

        return {
            x: p1.x + (p2.x - p1.x) * t,
            y: p1.y + (p2.y - p1.y) * t,
            z: p1.z + (p2.z - p1.z) * t,
            diam: p1.diam,
            cor: p1.cor,
            indexLimite: idx1
        };
    }

    function atualizarSimulador() {
        const canvas = document.getElementById('mainSimCanvas');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');

        const brutoX = parseFloat(document.getElementById('multi_brutoX').value) || 250;
        const brutoY = parseFloat(document.getElementById('multi_brutoY').value) || 250;
        const brutoZ = parseFloat(document.getElementById('multi_brutoZ').value) || 50;

        construirTrajetoSimulacao();
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        if (modoSimuladorAtual === '2D') {
            desenharSimulador2D(ctx, canvas, brutoX, brutoY);
        } else {
            desenharSimulador3D(ctx, canvas, brutoX, brutoY, brutoZ);
        }
    }

    function desenharSimulador2D(ctx, canvas, brutoX, brutoY) {
        const margin = 35;
        const scale = Math.min((canvas.width - margin * 2) / brutoX, (canvas.height - margin * 2) / brutoY);
        const cX = canvas.width / 2;
        const cY = canvas.height / 2;

        function toScreen(x, y) {
            return { x: cX + (x * scale), y: cY - (y * scale) };
        }

        ctx.strokeStyle = '#1e1e2e';
        ctx.lineWidth = 1;
        ctx.beginPath();
        for (let x = -250; x <= 250; x += 50) {
            let p1 = toScreen(x, -250); let p2 = toScreen(x, 250);
            ctx.moveTo(p1.x, p1.y); ctx.lineTo(p2.x, p2.y);
        }
        for (let y = -250; y <= 250; y += 50) {
            let p1 = toScreen(-250, y); let p2 = toScreen(250, y);
            ctx.moveTo(p1.x, p1.y); ctx.lineTo(p2.x, p2.y);
        }
        ctx.stroke();

        let oX = toScreen(0, 0);
        ctx.strokeStyle = '#3f3f5a';
        ctx.beginPath(); ctx.arc(oX.x, oX.y, 4, 0, Math.PI * 2); ctx.stroke();

        let bMin = toScreen(-brutoX / 2, brutoY / 2);
        let bMax = toScreen(brutoX / 2, -brutoY / 2);
        ctx.strokeStyle = '#ff9900';
        ctx.setLineDash([4, 4]);
        ctx.strokeRect(bMin.x, bMin.y, Math.abs(bMax.x - bMin.x), Math.abs(bMax.y - bMin.y));
        ctx.setLineDash([]);

        let pontoAtualInfo = obterPontoAtualAnimacao();
        let limiteIdx = pontoAtualInfo ? pontoAtualInfo.indexLimite : trajetoSimulacaoTotal.length;

        for (let i = 0; i < trajetoSimulacaoTotal.length - 1; i++) {
            let p1 = toScreen(trajetoSimulacaoTotal[i].x, trajetoSimulacaoTotal[i].y);
            let p2 = toScreen(trajetoSimulacaoTotal[i+1].x, trajetoSimulacaoTotal[i+1].y);

            ctx.strokeStyle = (i <= limiteIdx) ? trajetoSimulacaoTotal[i].cor : '#2a2a3d';
            ctx.lineWidth = (i <= limiteIdx) ? 2 : 1;

            ctx.beginPath();
            ctx.moveTo(p1.x, p1.y);
            ctx.lineTo(p2.x, p2.y);
            ctx.stroke();
        }

        if (pontoAtualInfo) {
            let posTela = toScreen(pontoAtualInfo.x, pontoAtualInfo.y);
            let raioFerramentaTela = (pontoAtualInfo.diam / 2) * scale;

            ctx.fillStyle = 'rgba(255, 255, 255, 0.25)';
            ctx.strokeStyle = '#ffffff';
            ctx.lineWidth = 1.5;

            ctx.beginPath();
            ctx.arc(posTela.x, posTela.y, raioFerramentaTela, 0, Math.PI * 2);
            ctx.fill();
            ctx.stroke();

            ctx.fillStyle = '#ff5555';
            ctx.beginPath();
            ctx.arc(posTela.x, posTela.y, 3, 0, Math.PI * 2);
            ctx.fill();
        }
    }

    function desenharSimulador3D(ctx, canvas, bx, by, bz) {
        const cX = canvas.width / 2;
        const cY = canvas.height / 2 + 30;

        const isoScale = 0.65;
        const cos = Math.cos(Math.PI / 6) * isoScale;
        const sin = Math.sin(Math.PI / 6) * isoScale;

        function isoProject(x, y, z) {
            return {
                x: cX + (x - y) * cos,
                y: cY + (x + y) * sin - (z * isoScale)
            };
        }

        let p0 = isoProject(-bx/2, -by/2, 0);
        let p1 = isoProject(bx/2, -by/2, 0);
        let p2 = isoProject(bx/2, by/2, 0);
        let p3 = isoProject(-bx/2, by/2, 0);

        let p0B = isoProject(-bx/2, -by/2, -bz);
        let p1B = isoProject(bx/2, -by/2, -bz);
        let p2B = isoProject(bx/2, by/2, -bz);
        let p3B = isoProject(-bx/2, by/2, -bz);

        ctx.fillStyle = '#2b2b3b';
        ctx.strokeStyle = '#00adb5';
        ctx.lineWidth = 1.5;

        ctx.beginPath();
        ctx.moveTo(p0.x, p0.y); ctx.lineTo(p1.x, p1.y); ctx.lineTo(p2.x, p2.y); ctx.lineTo(p3.x, p3.y); ctx.closePath();
        ctx.fill(); ctx.stroke();

        ctx.fillStyle = '#1e1e2e';
        ctx.beginPath();
        ctx.moveTo(p0.x, p0.y); ctx.lineTo(p1.x, p1.y); ctx.lineTo(p1B.x, p1B.y); ctx.lineTo(p0B.x, p0B.y); ctx.closePath();
        ctx.fill(); ctx.stroke();

        ctx.fillStyle = '#181825';
        ctx.beginPath();
        ctx.moveTo(p1.x, p1.y); ctx.lineTo(p2.x, p2.y); ctx.lineTo(p2B.x, p2B.y); ctx.lineTo(p1B.x, p1B.y); ctx.closePath();
        ctx.fill(); ctx.stroke();

        let pontoAtualInfo = obterPontoAtualAnimacao();
        let limiteIdx = pontoAtualInfo ? pontoAtualInfo.indexLimite : trajetoSimulacaoTotal.length;

        for (let i = 0; i < trajetoSimulacaoTotal.length - 1; i++) {
            let pt1 = isoProject(trajetoSimulacaoTotal[i].x, trajetoSimulacaoTotal[i].y, trajetoSimulacaoTotal[i].z);
            let pt2 = isoProject(trajetoSimulacaoTotal[i+1].x, trajetoSimulacaoTotal[i+1].y, trajetoSimulacaoTotal[i+1].z);

            ctx.strokeStyle = (i <= limiteIdx) ? trajetoSimulacaoTotal[i].cor : '#3f3f5a';
            ctx.lineWidth = (i <= limiteIdx) ? 2 : 1;

            ctx.beginPath();
            ctx.moveTo(pt1.x, pt1.y);
            ctx.lineTo(pt2.x, pt2.y);
            ctx.stroke();
        }

        if (pontoAtualInfo) {
            let pos3D = isoProject(pontoAtualInfo.x, pontoAtualInfo.y, pontoAtualInfo.z);
            let posTopo3D = isoProject(pontoAtualInfo.x, pontoAtualInfo.y, pontoAtualInfo.z + 25);

            ctx.strokeStyle = '#ffb86c';
            ctx.lineWidth = 4;
            ctx.beginPath();
            ctx.moveTo(pos3D.x, pos3D.y);
            ctx.lineTo(posTopo3D.x, posTopo3D.y);
            ctx.stroke();

            ctx.fillStyle = '#ff5555';
            ctx.beginPath();
            ctx.arc(pos3D.x, pos3D.y, 4, 0, Math.PI * 2);
            ctx.fill();
        }

        ctx.fillStyle = '#eeeeee';
        ctx.font = 'bold 11px Segoe UI';
        ctx.fillText(`Simulação 3D | Bruto: ${bx} x ${by} x ${bz} mm`, 15, 25);
    }

