<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Suíte CNC - Gerador Integrado G-Code CNC Real</title>
    <style>
        :root {
            --bg-color: #181825;
            --card-bg: #2b2b3b;
            --accent: #00adb5;
            --accent-hover: #008c93;
            --text-color: #eeeeee;
            --border-color: #3f3f5a;
            --danger: #ff5555;
            --warning: #ffb86c;
            --success: #a6e3a1;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 15px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .header-app {
            width: 100%;
            max-width: 1300px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
            border-bottom: 2px solid var(--border-color);
            padding-bottom: 10px;
        }

        .header-app h1 {
            margin: 0;
            color: var(--accent);
            font-size: 1.5rem;
        }

        .tabs-nav {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
        }

        .tab-btn {
            background-color: #313244;
            color: #ccc;
            border: 1px solid var(--border-color);
            padding: 9px 12px;
            border-radius: 6px 6px 0 0;
            cursor: pointer;
            font-weight: bold;
            font-size: 0.82rem;
            transition: all 0.2s;
        }

        .tab-btn:hover {
            background-color: #45475a;
            color: #fff;
        }

        .tab-btn.active {
            background-color: var(--accent);
            color: #fff;
            border-color: var(--accent);
        }

        .container {
            width: 100%;
            max-width: 1300px;
            display: grid;
            grid-template-columns: 480px 1fr;
            gap: 20px;
        }

        .panel {
            background-color: var(--card-bg);
            padding: 20px;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
            max-height: 85vh;
            overflow-y: auto;
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        h2 {
            margin-top: 0;
            color: var(--accent);
            font-size: 1.05rem;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 4px;
            margin-bottom: 10px;
        }

        .form-group {
            margin-bottom: 10px;
            display: flex;
            flex-direction: column;
        }

        .row-inputs {
            display: flex;
            gap: 8px;
        }

        .row-inputs .form-group {
            flex: 1;
        }

        .checkbox-group {
            display: flex;
            align-items: center;
            gap: 10px;
            background-color: #181825;
            padding: 8px 12px;
            border-radius: 4px;
            border: 1px solid var(--border-color);
            margin-bottom: 8px;
            cursor: pointer;
        }

        .checkbox-group input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
        }

        label {
            font-size: 0.8rem;
            margin-bottom: 3px;
            color: #b0b0c0;
        }

        input, select, textarea.input-txt {
            background-color: #181825;
            border: 1px solid var(--border-color);
            color: #fff;
            padding: 6px 10px;
            border-radius: 4px;
            font-size: 0.88rem;
            transition: all 0.3s ease;
        }

        input:focus, select:focus, textarea.input-txt:focus {
            outline: none;
            border-color: var(--accent);
        }

        .status-box {
            padding: 8px 12px;
            border-radius: 4px;
            font-size: 0.82rem;
            margin-bottom: 12px;
            font-weight: bold;
        }

        .status-box.ok {
            background-color: #1e3a29;
            color: var(--success);
            border: 1px solid var(--success);
        }

        .status-box.error {
            background-color: #3d1a24;
            color: var(--danger);
            border: 1px solid var(--danger);
        }

        .status-box.warning {
            background-color: #3d311a;
            color: var(--warning);
            border: 1px solid var(--warning);
        }

        button.btn-generate {
            background-color: var(--accent);
            color: #fff;
            border: none;
            padding: 12px;
            border-radius: 4px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 10px;
            transition: background 0.2s;
            width: 100%;
            font-size: 0.95rem;
        }

        button.btn-generate:hover {
            background-color: var(--accent-hover);
        }

        button.btn-secondary {
            background-color: #313244;
            color: #fff;
            border: 1px solid var(--border-color);
            padding: 8px;
            border-radius: 4px;
            font-weight: bold;
            cursor: pointer;
            transition: background 0.2s;
            width: 100%;
            font-size: 0.85rem;
            margin-top: 4px;
        }

        button.btn-secondary:hover {
            background-color: #45475a;
        }

        .table-furos {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
            font-size: 0.78rem;
        }

        .table-furos th, .table-furos td {
            border: 1px solid var(--border-color);
            padding: 5px;
            text-align: center;
        }

        .table-furos th {
            background-color: #181825;
            color: var(--accent);
        }

        .btn-del {
            background-color: var(--danger);
            color: #fff;
            border: none;
            border-radius: 3px;
            padding: 2px 6px;
            cursor: pointer;
            font-size: 0.75rem;
        }

        .output-container {
            display: flex;
            flex-direction: column;
        }

        /* --- SIMULADOR 3D/2D E PAINEL DE ANIMAÇÃO --- */
        .sim-wrapper {
            background-color: #11111b;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            padding: 10px;
            margin-bottom: 15px;
            display: flex;
            flex-direction: column;
        }

        .sim-header-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }

        .sim-title {
            margin: 0;
            font-size: 0.95rem;
            color: var(--accent);
            font-weight: bold;
        }

        .sim-mode-toggle {
            display: flex;
            gap: 4px;
        }

        .sim-toggle-btn {
            background-color: #181825;
            border: 1px solid var(--border-color);
            color: #ccc;
            padding: 4px 10px;
            font-size: 0.75rem;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
        }

        .sim-toggle-btn.active {
            background-color: var(--accent);
            color: #fff;
            border-color: var(--accent);
        }

        canvas.sim-canvas {
            background-color: #0b0b12;
            border: 1px solid #28283d;
            border-radius: 4px;
            width: 100%;
            height: 280px;
            box-sizing: border-box;
        }

        .sim-controls-bar {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-top: 8px;
            background-color: #181825;
            padding: 6px 10px;
            border-radius: 4px;
            border: 1px solid var(--border-color);
        }

        .btn-sim-control {
            background-color: #313244;
            color: #fff;
            border: 1px solid var(--border-color);
            padding: 5px 10px;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
            font-size: 0.8rem;
        }

        .btn-sim-control:hover {
            background-color: #45475a;
        }

        .sim-progress-slider {
            flex: 1;
            cursor: pointer;
        }

        .sim-speed-select {
            background-color: #11111b;
            color: #fff;
            border: 1px solid var(--border-color);
            font-size: 0.75rem;
            padding: 3px 6px;
            border-radius: 4px;
        }

        .sim-legenda {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 8px;
            background-color: #181825;
            padding: 6px 10px;
            border-radius: 4px;
            border: 1px solid var(--border-color);
            font-size: 0.72rem;
        }

        .legenda-item {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .legenda-box {
            width: 100px;
            height: 10px;
            border-radius: 2px;
        }

        textarea.gcode-area {
            width: 100%;
            height: 350px;
            background-color: #11111b;
            color: #a6e3a1;
            font-family: 'Courier New', Courier, monospace;
            border: 1px solid var(--border-color);
            padding: 15px;
            border-radius: 4px;
            resize: vertical;
            box-sizing: border-box;
            font-size: 0.85rem;
            line-height: 1.4;
        }

        .actions-bar {
            display: flex;
            gap: 10px;
            margin-top: 10px;
            align-self: flex-end;
            flex-wrap: wrap;
        }

        .btn-action {
            background-color: #313244;
            color: #fff;
            border: 1px solid var(--border-color);
            padding: 10px 16px;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.2s;
            font-size: 0.88rem;
        }

        .btn-action:hover:not(:disabled) {
            background-color: #45475a;
        }

        .btn-action:disabled {
            background-color: #21222c;
            color: #555566;
            border: 1px solid #333344;
            cursor: not-allowed;
            opacity: 0.6;
        }

        /* --- ESTILOS DA CALCULADORA MODAL FLUTUANTE --- */
        .calc-modal {
            display: none;
            position: fixed;
            z-index: 1000;
            top: 80px;
            left: calc(50% - 160px);
            width: 320px;
            background-color: #1e1e2e;
            border: 2px solid var(--accent);
            border-radius: 10px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.6);
            overflow: hidden;
        }

        .calc-header {
            background-color: var(--accent);
            color: #fff;
            padding: 10px 15px;
            font-weight: bold;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: move;
            user-select: none;
        }

        .calc-header span.calc-title {
            font-size: 0.95rem;
        }

        .btn-close-calc {
            background: none;
            border: none;
            color: #fff;
            font-size: 1.2rem;
            cursor: pointer;
            font-weight: bold;
            line-height: 1;
        }

        .calc-body {
            padding: 15px;
        }

        .calc-display {
            width: 100%;
            height: 45px;
            background-color: #11111b;
            color: #a6e3a1;
            font-family: 'Courier New', Courier, monospace;
            border: 1px solid var(--border-color);
            border-radius: 5px;
            text-align: right;
            padding: 8px 12px;
            font-size: 1.2rem;
            box-sizing: border-box;
            margin-bottom: 12px;
        }

        .calc-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 6px;
        }

        .calc-btn {
            background-color: #313244;
            color: #fff;
            border: 1px solid var(--border-color);
            padding: 10px;
            font-size: 0.9rem;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
            transition: background 0.15s;
        }

        .calc-btn:hover {
            background-color: #45475a;
        }

        .calc-btn.operator {
            background-color: #f5e0dc;
            color: #11111b;
        }

        .calc-btn.operator:hover {
            background-color: #f2cdcd;
        }

        .calc-btn.func {
            background-color: #89b4fa;
            color: #11111b;
        }

        .calc-btn.func:hover {
            background-color: #74c7ec;
        }

        .calc-btn.equals {
            background-color: var(--accent);
            color: #fff;
            grid-column: span 2;
        }

        .calc-btn.equals:hover {
            background-color: var(--accent-hover);
        }

        .calc-btn.clear {
            background-color: var(--danger);
            color: #fff;
        }

        @media (max-width: 950px) {
            .container {
                grid-template-columns: 1fr;
            }
            .header-app {
                flex-direction: column;
                gap: 10px;
            }
        }
    </style>
</head>
<body>

<div class="header-app">
    <h1>Suíte CNC - Gerador Integrado CNC Real</h1>
    <div class="tabs-nav">
        <button class="tab-btn active" onclick="abrirAba('aba-combinado', this)">★ Multi-Operações</button>
        <button class="tab-btn" onclick="abrirAba('aba-faceamento', this)">1. Faceamento</button>
        <button class="tab-btn" onclick="abrirAba('aba-contorno', this)">2. Contorno</button>
        <button class="tab-btn" onclick="abrirAba('aba-matriz', this)">3. Matriz Ilhas</button>
        <button class="tab-btn" onclick="abrirAba('aba-lista-furos', this)">4. Lista / Padrões Furos</button>
        <button class="tab-btn" onclick="abrirAba('aba-cavidade', this)">5. Cavidades c/ Alívio</button>
    </div>
</div>

<div class="container">
    <!-- PAINEL DE CONFIGURAÇÕES -->
    <div class="panel">

        <!-- ABA COMPLETA: MULTI-OPERAÇÕES -->
        <div id="aba-combinado" class="tab-content active">
            <h2>Seleção de Operações do Programa Único</h2>
            <div class="checkbox-group">
                <input type="checkbox" id="chk_faceamento" checked>
                <label for="chk_faceamento" style="margin:0; cursor:pointer; color:#fff; font-weight:bold;">1. Incluir Operação de Faceamento</label>
            </div>
            <div class="checkbox-group">
                <input type="checkbox" id="chk_contorno" checked>
                <label for="chk_contorno" style="margin:0; cursor:pointer; color:#fff; font-weight:bold;">2. Incluir Operação de Contorno Externo</label>
            </div>
            <div class="checkbox-group">
                <input type="checkbox" id="chk_matriz" checked>
                <label for="chk_matriz" style="margin:0; cursor:pointer; color:#fff; font-weight:bold;">3. Incluir Operação de Matriz de Ilhas</label>
            </div>
            <div class="checkbox-group">
                <input type="checkbox" id="chk_lista_furos" checked>
                <label for="chk_lista_furos" style="margin:0; cursor:pointer; color:#fff; font-weight:bold;">4. Incluir Furações com Brocas Específicas</label>
            </div>
            <div class="checkbox-group">
                <input type="checkbox" id="chk_cavidade" checked>
                <label for="chk_cavidade" style="margin:0; cursor:pointer; color:#fff; font-weight:bold;">5. Incluir Usinagem de Cavidade(s) Reta(s)</label>
            </div>

            <h2>Parâmetros Gerais do Bruto</h2>
            <div class="form-group">
                <label for="multi_zeroPeca">Zero Peça:</label>
                <select id="multi_zeroPeca">
                    <option value="G54" selected>G54 (Centro do Bruto)</option>
                    <option value="G55">G55 (Centro do Bruto)</option>
                    <option value="G56">G56 (Centro do Bruto)</option>
                    <option value="G57">G57 (Centro do Bruto)</option>
                    <option value="G58">G58 (Centro do Bruto)</option>
                    <option value="G59">G59 (Centro do Bruto)</option>
                </select>
            </div>
            <div class="form-group">
                <label for="multi_brutoX">Comprimento do Bruto X (mm):</label>
                <input type="number" id="multi_brutoX" value="250.0" step="0.1">
            </div>
            <div class="form-group">
                <label for="multi_brutoY">Largura do Bruto Y (mm):</label>
                <input type="number" id="multi_brutoY" value="250.0" step="0.1">
            </div>
            <div class="form-group">
                <label for="multi_brutoZ">Espessura do Bruto Z (mm):</label>
                <input type="number" id="multi_brutoZ" value="50.0" step="0.1">
            </div>
            <div class="form-group">
                <label for="multi_oleo">Refrigeração / Óleo:</label>
                <select id="multi_oleo">
                    <option value="/M8" selected>Com Óleo (/M8)</option>
                    <option value="M9">Sem Óleo (M9)</option>
                </select>
            </div>
            <div class="checkbox-group">
                <input type="checkbox" id="multi_useM01" checked>
                <label for="multi_useM01" style="margin:0; cursor:pointer; color:#fff; font-weight:bold;">Inserir M01 (Parada Opcional) Antes das Trocas</label>
            </div>

            <button class="btn-generate" onclick="gerarProgramaCombinado()">Gerar Programa Único Combinado</button>
        </div>

        <!-- ABA 1: FACEAMENTO -->
        <div id="aba-faceamento" class="tab-content">
            <h2>Faceamento Individual</h2>
            <div class="form-group">
                <label for="f_zeroPeca">Zero Peça:</label>
                <select id="f_zeroPeca">
                    <option value="G54" selected>G54</option>
                    <option value="G55">G55</option>
                    <option value="G56">G56</option>
                </select>
            </div>
            <div class="form-group">
                <label for="f_compX">Comprimento em X (mm):</label>
                <input type="number" id="f_compX" value="250.0" step="0.1">
            </div>
            <div class="form-group">
                <label for="f_largY">Largura em Y (mm):</label>
                <input type="number" id="f_largY" value="250.0" step="0.1">
            </div>
            <div class="form-group">
                <label for="f_numT">Ferramenta (T):</label>
                <input type="number" id="f_numT" value="1">
            </div>
            <div class="form-group">
                <label for="f_diam">Diâmetro (mm):</label>
                <input type="number" id="f_diam" value="70" step="0.1">
            </div>
            <div class="form-group">
                <label for="f_rpm">RPM:</label>
                <input type="number" id="f_rpm" value="660">
            </div>
            <div class="form-group">
                <label for="f_avanco">Avanço (mm/min):</label>
                <input type="number" id="f_avanco" value="600">
            </div>
            <div class="form-group">
                <label for="f_zAprox">Z Aproximação / Segurança (mm):</label>
                <input type="number" id="f_zAprox" value="5.0" step="0.1">
            </div>
            <div class="form-group">
                <label for="f_zInicial">Z Inicial (mm):</label>
                <input type="number" id="f_zInicial" value="0.0" step="0.1">
            </div>
            <div class="form-group">
                <label for="f_zPasse">Passe por Camada (mm):</label>
                <input type="number" id="f_zPasse" value="0.5" step="0.05">
            </div>
            <div class="form-group">
                <label for="f_zFinal">Z Final (mm):</label>
                <input type="number" id="f_zFinal" value="-1.0" step="0.1">
            </div>
            <button class="btn-generate" onclick="gerarFaceamento()">Gerar Apenas Faceamento</button>
        </div>

        <!-- ABA 2: CONTORNO -->
        <div id="aba-contorno" class="tab-content">
            <h2>Contorno Individual (Desbaste)</h2>
            <div class="form-group">
                <label for="c_zeroPeca">Zero Peça:</label>
                <select id="c_zeroPeca">
                    <option value="G54" selected>G54</option>
                    <option value="G55">G55</option>
                </select>
            </div>
            <div class="form-group">
                <label for="c_compX">Comprimento em X (mm):</label>
                <input type="number" id="c_compX" value="250.0" step="0.1">
            </div>
            <div class="form-group">
                <label for="c_largY">Largura em Y (mm):</label>
                <input type="number" id="c_largY" value="250.0" step="0.1">
            </div>
            <div class="form-group">
                <label for="c_numTDesb">Ferramenta Desbaste (T):</label>
                <input type="number" id="c_numTDesb" value="18">
            </div>
            <div class="form-group">
                <label for="c_diamDesb">Diâmetro Desbaste (mm):</label>
                <input type="number" id="c_diamDesb" value="32" step="0.1">
            </div>
            <div class="form-group">
                <label for="c_rpmDesb">RPM Desbaste:</label>
                <input type="number" id="c_rpmDesb" value="2200">
            </div>
            <div class="form-group">
                <label for="c_avancoDesb">Avanço Desbaste (mm/min):</label>
                <input type="number" id="c_avancoDesb" value="800">
            </div>
            <div class="form-group">
                <label for="c_sobremetal">Sobremetal X/Y (mm):</label>
                <input type="number" id="c_sobremetal" value="0.3" step="0.05">
            </div>

            <h2>Acabamento do Contorno (Opcional)</h2>
            <div class="form-group">
                <label for="c_execAcab">Executar Acabamento?</label>
                <select id="c_execAcab" onchange="alternarAcabamentoContorno()">
                    <option value="SIM" selected>Sim</option>
                    <option value="NAO">Não</option>
                </select>
            </div>
            <div id="blocoAcabamentoContorno">
                <div class="form-group">
                    <label for="c_numTAcab">Ferramenta Acabamento (T):</label>
                    <input type="number" id="c_numTAcab" value="16">
                </div>
                <div class="form-group">
                    <label for="c_diamAcab">Diâmetro Acabamento (mm):</label>
                    <input type="number" id="c_diamAcab" value="20" step="0.1">
                </div>
                <div class="form-group">
                    <label for="c_rpmAcab">RPM Acabamento:</label>
                    <input type="number" id="c_rpmAcab" value="3200">
                </div>
                <div class="form-group">
                    <label for="c_avancoAcab">Avanço Acabamento (mm/min):</label>
                    <input type="number" id="c_avancoAcab" value="1200">
                </div>
            </div>

            <h2>Profundidades do Contorno</h2>
            <div class="form-group">
                <label for="c_zAprox">Z Aproximação / Segurança (mm):</label>
                <input type="number" id="c_zAprox" value="5.0" step="0.1">
            </div>
            <div class="form-group">
                <label for="c_zInicial">Z Inicial (mm):</label>
                <input type="number" id="c_zInicial" value="0.0" step="0.1">
            </div>
            <div class="form-group">
                <label for="c_zPasse">Passe por Volta (mm):</label>
                <input type="number" id="c_zPasse" value="1.0" step="0.05">
            </div>
            <div class="form-group">
                <label for="c_zFinal">Z Final (mm):</label>
                <input type="number" id="c_zFinal" value="12.0" step="0.1">
            </div>
            <button class="btn-generate" onclick="gerarContornoRampa()">Gerar Apenas Contorno</button>
        </div>

        <!-- ABA 3: MATRIZ -->
