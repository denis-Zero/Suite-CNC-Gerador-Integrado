    function gerarMalhaFuros() {
        const tipo = document.getElementById('tipo_padrao_furo').value;
        const colunas = parseInt(document.getElementById('malha_colunas').value) || 1;
        const linhas = parseInt(document.getElementById('malha_linhas').value) || 1;
        const distX = parseFloat(document.getElementById('malha_distX').value) || 0;
        const distY = parseFloat(document.getElementById('malha_distY').value) || 0;
        const broca = obterParametrosBrocaAtiva();

        const inicioX = -((colunas - 1) * distX) / 2;
        const inicioY = -((linhas - 1) * distY) / 2;

        for (let l = 0; l < linhas; l++) {
            for (let c = 0; c < colunas; c++) {
                let posX = inicioX + (c * distX);
                let posY = inicioY + (l * distY);

                if (tipo === 'TRIANGULAR' && (l % 2 !== 0)) {
                    posX += (distX / 2);
                }

                listaFurosCustom.push({x: posX, y: posY, ...broca});
            }
        }
        renderizarTabelaFuros();
        atualizarSimulador();
    }

    function gerarPadraoFlange() {
        const qtd = parseInt(document.getElementById('pcd_qtd').value) || 0;
        const raio = parseFloat(document.getElementById('pcd_raio').value) || 0;
        const angInicial = parseFloat(document.getElementById('pcd_ang').value) || 0;

        if (qtd <= 0) return;
        const broca = obterParametrosBrocaAtiva();

        const passoAng = 360 / qtd;
        for (let i = 0; i < qtd; i++) {
            let anguloRad = (angInicial + (i * passoAng)) * (Math.PI / 180);
            let posX = raio * Math.cos(anguloRad);
            let posY = raio * Math.sin(anguloRad);
            listaFurosCustom.push({x: posX, y: posY, ...broca});
        }
        renderizarTabelaFuros();
        atualizarSimulador();
    }

    function carregarMalhaPersonalizada() {
        const texto = document.getElementById('txt_coords_projeto').value;
        const linhas = texto.split('\n');
        const broca = obterParametrosBrocaAtiva();
        let adicionados = 0;

        linhas.forEach(linha => {
            const partes = linha.split(/[,;\s\t]+/);
            if (partes.length >= 2) {
                const x = parseFloat(partes[0]);
                const y = parseFloat(partes[1]);
                if (!isNaN(x) && !isNaN(y)) {
                    listaFurosCustom.push({x, y, ...broca});
                    adicionados++;
                }
            }
        });

        if (adicionados > 0) {
            renderizarTabelaFuros();
            document.getElementById('txt_coords_projeto').value = '';
            atualizarSimulador();
        } else {
            alert("Nenhuma coordenada válida encontrada. Use o formato: X, Y por linha.");
        }
    }

