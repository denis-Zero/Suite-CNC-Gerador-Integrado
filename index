    // --- LÓGICA DA CALCULADORA ---
    let calcExpressao = "0";
    let calcAns = 0;
    let calcNovaEntrada = true;

    function alternarCalculadora() {
        const modal = document.getElementById('calcModal');
        if (modal.style.display === 'block') {
            modal.style.display = 'none';
        } else {
            modal.style.display = 'block';
        }
    }

    function atualizarDisplayCalc() {
        document.getElementById('calcDisplay').value = calcExpressao.replace(/Math\.PI/g, 'π');
    }

    function addCalc(valor) {
        if (calcNovaEntrada && !isNaN(valor)) {
            calcExpressao = valor;
            calcNovaEntrada = false;
        } else {
            if (calcExpressao === "0" && !isNaN(valor)) {
                calcExpressao = valor;
            } else {
                calcExpressao += valor;
            }
            calcNovaEntrada = false;
        }
        atualizarDisplayCalc();
    }

    function limparCalc() {
        calcExpressao = "0";
        calcNovaEntrada = true;
        atualizarDisplayCalc();
    }

    function apagarDigitoCalc() {
        if (calcExpressao.length > 1) {
            calcExpressao = calcExpressao.slice(0, -1);
        } else {
            calcExpressao = "0";
            calcNovaEntrada = true;
        }
        atualizarDisplayCalc();
    }

    function execFuncCalc(funcao) {
        try {
            let val = parseFloat(eval(calcExpressao));
            let res = 0;
            if (funcao === 'sin') res = Math.sin(val * Math.PI / 180);
            if (funcao === 'cos') res = Math.cos(val * Math.PI / 180);
            if (funcao === 'tan') res = Math.tan(val * Math.PI / 180);
            if (funcao === 'sqrt') res = Math.sqrt(val);
            if (funcao === 'sqr') res = Math.pow(val, 2);

            calcExpressao = Number(res.toFixed(6)).toString();
            calcAns = res;
            calcNovaEntrada = true;
            atualizarDisplayCalc();
        } catch (e) {
            calcExpressao = "Erro";
            calcNovaEntrada = true;
            atualizarDisplayCalc();
        }
    }

    function usarAnsCalc() {
        addCalc(calcAns.toString());
    }

    function calcularResultadoCalc() {
        try {
            let res = eval(calcExpressao);
            calcExpressao = Number(res.toFixed(6)).toString();
            calcAns = res;
            calcNovaEntrada = true;
            atualizarDisplayCalc();
        } catch (e) {
            calcExpressao = "Erro";
            calcNovaEntrada = true;
            atualizarDisplayCalc();
        }
    }

    (function arrastarCalculadora() {
        const modal = document.getElementById("calcModal");
        const header = document.getElementById("calcHeader");
        let posX = 0, posY = 0, mouseX = 0, mouseY = 0;

        if (header) {
            header.onmousedown = arrastarMouseDown;
        }

        function arrastarMouseDown(e) {
            e.preventDefault();
            mouseX = e.clientX;
            mouseY = e.clientY;
            document.onmouseup = fecharArrasto;
            document.onmousemove = elementoArrastar;
        }

        function elementoArrastar(e) {
            e.preventDefault();
            posX = mouseX - e.clientX;
            posY = mouseY - e.clientY;
            mouseX = e.clientX;
            mouseY = e.clientY;
            modal.style.top = (modal.offsetTop - posY) + "px";
            modal.style.left = (modal.offsetLeft - posX) + "px";
        }

        function fecharArrasto() {
            document.onmouseup = null;
            document.onmousemove = null;
        }
    })();

    document.addEventListener('keydown', function(event) {
        const modal = document.getElementById('calcModal');
        if (modal && modal.style.display === 'block') {
            if ((event.key >= '0' && event.key <= '9') || event.key === '.' || event.key === '+' || event.key === '-' || event.key === '*' || event.key === '/' || event.key === '(' || event.key === ')') {
                addCalc(event.key);
            } else if (event.key === 'Enter') {
                calcularResultadoCalc();
            } else if (event.key === 'Backspace') {
                apagarDigitoCalc();
            } else if (event.key === 'Escape') {
                limparCalc();
            }
        }
    });

