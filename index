    function validarMatriz() {
        const brutoX = parseFloat(document.getElementById('m_brutoX').value) || 0;
        const brutoY = parseFloat(document.getElementById('m_brutoY').value) || 0;
        const colunas = parseInt(document.getElementById('m_colunas').value) || 0;
        const linhas = parseInt(document.getElementById('m_linhas').value) || 0;
        const tamX = parseFloat(document.getElementById('m_tamX').value) || 0;
        const tamY = parseFloat(document.getElementById('m_tamY').value) || 0;
        const canal = parseFloat(document.getElementById('m_canal').value) || 0;
        const diam = parseFloat(document.getElementById('m_diam').value) || 0;
        const zAprox = parseFloat(document.getElementById('m_zAprox').value) || 0;
        const zInicial = parseFloat(document.getElementById('m_zInicial').value) || 0;

        const statusBox = document.getElementById('statusMatriz');
        const btn = document.getElementById('btnGerarMatriz');

        if (zAprox <= zInicial) {
            statusBox.className = "status-box error";
            statusBox.innerHTML = `ERRO: Z Aproximação (${zAprox} mm) deve ser MAIOR que Z Inicial (${zInicial} mm)!`;
            if (btn) btn.disabled = true;
            return false;
        }

        if (diam > canal) {
            statusBox.className = "status-box error";
            statusBox.innerHTML = `ERRO: Diâmetro da fresa (${diam} mm) > canal (${canal} mm)! A ferramenta colidirá com as ilhas.`;
            if (btn) btn.disabled = true;
            return false;
        }

        const necX = (colunas * tamX) + ((colunas - 1) * canal) + (2 * canal);
        const necY = (linhas * tamY) + ((linhas - 1) * canal) + (2 * canal);

        if (necX > brutoX || necY > brutoY) {
            statusBox.className = "status-box error";
            statusBox.innerHTML = `ERRO: Bruto (${brutoX}x${brutoY} mm) é MENOR que o necessário (${necX.toFixed(1)}x${necY.toFixed(1)} mm)!`;
            if (btn) btn.disabled = true;
            return false;
        } else {
            statusBox.className = "status-box ok";
            statusBox.innerHTML = `OK: Matriz compatível e centralizada em X0 Y0. Área: ${necX.toFixed(1)} x ${necY.toFixed(1)} mm.`;
            if (btn) btn.disabled = false;
            return true;
        }
    }

    function copiarCodigo() {
        const copyText = document.getElementById("codigoGcode");
        if (!copyText.value.trim()) return;

        if (codigoFoiCopiado) {
            const desejaRecopiar = confirm("Este código já foi copiado.\n\nDeseja copiá-lo novamente?");
            if (!desejaRecopiar) return;
        }

        copyText.select();
        document.execCommand("copy");
        codigoFoiCopiado = true;
        alert("Programa CNC copiado para a área de transferência!");
    }

    // --- RELATÓRIO TXT ---
    function baixarRelatorioTXT() {
        const incFace = document.getElementById('chk_faceamento').checked;
        const incCont = document.getElementById('chk_contorno').checked;
        const incMatr = document.getElementById('chk_matriz').checked;
        const incList = document.getElementById('chk_lista_furos').checked;
        const incCav  = document.getElementById('chk_cavidade').checked;

        let ferramentasUsadas = [];
        let operacoesResumo = [];
        let tempoTotalMinutos = 0;

        if (incFace) {
            const t = parseInt(document.getElementById('f_numT').value);
            const diam = parseFloat(document.getElementById('f_diam').value);
            const zFinal = parseFloat(document.getElementById('f_zFinal').value);
            const avanco = parseInt(document.getElementById('f_avanco').value);
            const compX = parseFloat(document.getElementById('f_compX').value);
            const largY = parseFloat(document.getElementById('f_largY').value);
            const zPasse = parseFloat(document.getElementById('f_zPasse').value);

            ferramentasUsadas.push({ t, diam, tipo: 'Cabeçote de Facear' });
            let distPasse = (compX + diam * 2) * (largY / (diam * 0.6));
            let qtdPassesZ = Math.ceil(Math.abs(zFinal) / zPasse);
            let tempoMin = (distPasse * qtdPassesZ) / avanco;
            tempoTotalMinutos += tempoMin;

            operacoesResumo.push(`- Faceamento: Profundidade Z = ${zFinal.toFixed(1)} mm | Ferramenta T${t} (Ø${diam}mm) | Tempo ~ ${tempoMin.toFixed(2)} min`);
        }

        if (incCont) {
            const t = parseInt(document.getElementById('c_numTDesb').value);
            const diam = parseFloat(document.getElementById('c_diamDesb').value);
            const zFinal = Math.abs(parseFloat(document.getElementById('c_zFinal').value));
            const avanco = parseInt(document.getElementById('c_avancoDesb').value);
            const compX = parseFloat(document.getElementById('c_compX').value);
            const largY = parseFloat(document.getElementById('c_largY').value);
            const zPasse = parseFloat(document.getElementById('c_zPasse').value);

            ferramentasUsadas.push({ t, diam, tipo: 'Fresa Desbaste Contorno' });
            let perimetro = (compX + largY) * 2;
            let voltas = Math.ceil(zFinal / zPasse);
            let tempoMin = (perimetro * voltas) / avanco;

            if (document.getElementById('c_execAcab').value === 'SIM') {
                const tAcab = parseInt(document.getElementById('c_numTAcab').value);
                const diamAcab = parseFloat(document.getElementById('c_diamAcab').value);
                const avancoAcab = parseInt(document.getElementById('c_avancoAcab').value);
                ferramentasUsadas.push({ t: tAcab, diam: diamAcab, tipo: 'Fresa Acabamento Contorno' });
                tempoMin += (perimetro / avancoAcab);
            }

            tempoTotalMinutos += tempoMin;
            operacoesResumo.push(`- Contorno Externo: Profundidade Z = -${zFinal.toFixed(1)} mm | Tempo ~ ${tempoMin.toFixed(2)} min`);
        }

        if (incMatr) {
            const tDesb = parseInt(document.getElementById('m_numT').value);
            const diamDesb = parseFloat(document.getElementById('m_diam').value);
            const zFinal = Math.abs(parseFloat(document.getElementById('m_zFinal').value));
            const avancoDesb = parseInt(document.getElementById('m_avanco').value);
            const colunas = parseInt(document.getElementById('m_colunas').value);
            const linhas = parseInt(document.getElementById('m_linhas').value);

            ferramentasUsadas.push({ t: tDesb, diam: diamDesb, tipo: 'Fresa Desbaste Ilhas' });
            let tempoMin = ((colunas * linhas) * zFinal * 400) / avancoDesb;

            if (document.getElementById('m_execAcab').value === 'SIM') {
                const tAcab = parseInt(document.getElementById('m_numTAcab').value);
                const diamAcab = parseFloat(document.getElementById('m_diamAcab').value);
                ferramentasUsadas.push({ t: tAcab, diam: diamAcab, tipo: 'Fresa Acabamento Ilhas' });
                tempoMin += 1.5;
            }
            tempoTotalMinutos += tempoMin;

            operacoesResumo.push(`- Matriz de Ilhas (${colunas}x${linhas}): Profundidade Z = -${zFinal.toFixed(1)} mm | Tempo ~ ${tempoMin.toFixed(2)} min`);
        }

        if (incList && listaFurosCustom.length > 0) {
            let tempoFuração = 0;
            listaFurosCustom.forEach(furo => {
                ferramentasUsadas.push({ t: furo.t, diam: furo.diam, tipo: 'Broca' });
                let picaPaus = Math.ceil(furo.zFinal / furo.qPasse);
                let distTotalMM = furo.zFinal * picaPaus;
                tempoFuração += (distTotalMM / furo.avanco);
            });
            tempoTotalMinutos += tempoFuração;
            operacoesResumo.push(`- Lista de Furações (${listaFurosCustom.length} furos): Tempo ~ ${tempoFuração.toFixed(2)} min`);
        }

        if (incCav) {
            const centros = obterCentrosCavidades();
            const execAlivio = document.getElementById('cav_execAlivio').checked;
            const execContorno = document.getElementById('cav_execContornoRaio').checked;
            const fresaT = parseInt(document.getElementById('cav_fresaT').value);
            const fresaDiam = parseFloat(document.getElementById('cav_fresaDiam').value);
            const acabT = parseInt(document.getElementById('cav_acabT').value);
            const acabDiam = parseFloat(document.getElementById('cav_acabDiam').value);
            const zFinal = Math.abs(parseFloat(document.getElementById('cav_zFinal').value));

            if (execAlivio) {
                listaBrocasAlivio.forEach(b => {
                    ferramentasUsadas.push({ t: b.t, diam: b.diam, tipo: 'Broca Pré-Furo Alívio' });
                });
            }
            ferramentasUsadas.push({ t: fresaT, diam: fresaDiam, tipo: 'Fresa Desbaste Cavidade' });

            if (execContorno) {
                ferramentasUsadas.push({ t: acabT, diam: acabDiam, tipo: 'Fresa Acabamento/Canto Cavidade' });
            }

            let tempoMin = centros.length * ((execAlivio ? listaBrocasAlivio.length * 0.8 : 0) + (zFinal * 0.3) + (execContorno ? 1.2 : 0));
            tempoTotalMinutos += tempoMin;
            operacoesResumo.push(`- Cavidades Retas [${centros.length} cavidade(s)] (${execAlivio ? listaBrocasAlivio.length + ' Broca(s) Alívio' : 'Sem Alívio'}${execContorno ? ' + Contorno Raio' : ''}): Profundidade Z = -${zFinal.toFixed(1)} mm | Tempo ~ ${tempoMin.toFixed(2)} min`);
        }

        let ferramentasUnicas = [];
        let mapa = {};
        ferramentasUsadas.forEach(f => {
            if (!mapa[f.t]) {
                mapa[f.t] = f;
                ferramentasUnicas.push(f);
            }
        });

        let txt = `==================================================\n`;
        txt += ` RELATÓRIO DE PREPARAÇÃO E USINAGEM CNC\n`;
        txt += ` Data: ${new Date().toLocaleDateString('pt-BR')} ${new Date().toLocaleTimeString('pt-BR')}\n`;
        txt += `==================================================\n\n`;

        txt += `1. LISTA DE FERRAMENTAS UTILIZADAS:\n`;
        ferramentasUnicas.forEach(f => {
            txt += `   - Ferramenta T${f.t.toString().padStart(2, '0')} | Diâmetro: ${f.diam.toFixed(1).padStart(4, ' ')} mm | Função: ${f.tipo}\n`;
        });

        txt += `\n2. RESUMO DAS OPERAÇÕES E PROFUNDIDADES:\n`;
        operacoesResumo.forEach(op => {
            txt += `   ${op}\n`;
        });

        txt += `\n3. TEMPO ESTIMADO DE USINAGEM:\n`;
        txt += `   - Tempo Total Aproximado: ${tempoTotalMinutos.toFixed(2)} minutos (${Math.ceil(tempoTotalMinutos * 60)} segundos)\n`;
        txt += `   (Obs: O tempo considera avanços de corte G1/G83 sem computar trocas manuais/rápidos G0).\n\n`;
        txt += `==================================================\n`;

        let blob = new Blob([txt], { type: 'text/plain;charset=utf-8' });
        let link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = 'Relatorio_Preparacao_CNC.txt';
        link.click();
    }

