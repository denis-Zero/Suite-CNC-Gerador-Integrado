    function obterCentrosCavidades() {
        const modo = document.getElementById('cav_modoPosicao').value;
        let listaCentros = [];

        if (modo === 'UNICA') {
            const centroX = parseFloat(document.getElementById('cav_centroX').value) || 0;
            const centroY = parseFloat(document.getElementById('cav_centroY').value) || 0;
            listaCentros.push({ x: centroX, y: centroY });
        } else {
            const colunas = parseInt(document.getElementById('cav_colunas').value) || 1;
            const linhas = parseInt(document.getElementById('cav_linhas').value) || 1;
            const distX = parseFloat(document.getElementById('cav_distX').value) || 0;
            const distY = parseFloat(document.getElementById('cav_distY').value) || 0;

            const inicioX = -((colunas - 1) * distX) / 2;
            const inicioY = -((linhas - 1) * distY) / 2;

            for (let l = 0; l < linhas; l++) {
                for (let c = 0; c < colunas; c++) {
                    listaCentros.push({
                        x: inicioX + (c * distX),
                        y: inicioY + (l * distY)
                    });
                }
            }
        }
        return listaCentros;
    }

    function validarCavidade() {
        const dimX = parseFloat(document.getElementById('cav_dimX').value) || 0;
        const dimY = parseFloat(document.getElementById('cav_dimY').value) || 0;
        const alivioOffX = parseFloat(document.getElementById('cav_alivioOffX').value) || 0;
        const alivioOffY = parseFloat(document.getElementById('cav_alivioOffY').value) || 0;

        const fresaDiam = parseFloat(document.getElementById('cav_fresaDiam').value) || 0;
        const acabDiam = parseFloat(document.getElementById('cav_acabDiam').value) || 0;

        const execAlivio = document.getElementById('cav_execAlivio').checked;
        const execContorno = document.getElementById('cav_execContornoRaio').checked;

        const statusBox = document.getElementById('statusCavidade');
        const btn = document.getElementById('btnGerarCavidade');

        if (fresaDiam >= dimX || fresaDiam >= dimY) {
            statusBox.className = "status-box error";
            statusBox.innerHTML = `ERRO: Diâmetro da fresa de desbaste (${fresaDiam} mm) deve ser menor que as dimensões da cavidade (${dimX}x${dimY} mm)!`;
            if (btn) btn.disabled = true;
            return false;
        }

        if (execContorno && acabDiam >= fresaDiam) {
            statusBox.className = "status-box error";
            statusBox.innerHTML = `ERRO: Diâmetro da fresa de acabamento (${acabDiam} mm) deve ser MENOR que a fresa de desbaste (${fresaDiam} mm) para reduzir o raio dos cantos!`;
            if (btn) btn.disabled = true;
            return false;
        }

        if (execAlivio) {
            if (listaBrocasAlivio.length === 0) {
                statusBox.className = "status-box error";
                statusBox.innerHTML = `ERRO: Cadastre pelo menos uma broca na tabela de alívio!`;
                if (btn) btn.disabled = true;
                return false;
            }

            let maiorBroca = listaBrocasAlivio[listaBrocasAlivio.length - 1];
            let brocaDiam = maiorBroca.diam;

            const minPermitidoX = -(dimX / 2) + (brocaDiam / 2);
            const maxPermitidoX = (dimX / 2) - (brocaDiam / 2);
            const minPermitidoY = -(dimY / 2) + (brocaDiam / 2);
            const maxPermitidoY = (dimY / 2) - (brocaDiam / 2);

            if (alivioOffX < minPermitidoX || alivioOffX > maxPermitidoX || alivioOffY < minPermitidoY || alivioOffY > maxPermitidoY) {
                statusBox.className = "status-box error";
                statusBox.innerHTML = `ERRO: Offset do alívio (${alivioOffX}, ${alivioOffY}) ultrapassa os limites internos da cavidade com a broca maior Ø${brocaDiam}mm!`;
                if (btn) btn.disabled = true;
                return false;
            }
        }

        const centros = obterCentrosCavidades();
        let msg = `OK: ${centros.length} cavidade(s) ${dimX}x${dimY}mm válida(s).`;
        if (execAlivio) msg += ` Alívio com ${listaBrocasAlivio.length} broca(s).`;
        if (execContorno) msg += ` Contorno com Ø${acabDiam}mm.`;

        statusBox.className = "status-box ok";
        statusBox.innerHTML = msg;
        if (btn) btn.disabled = false;
        return true;
    }

    // --- FUNÇÕES GERADORAS DE CÓDIGO NO PADRÃO CNC REAL ---

    function obterBlocoFaceamento(zeroPeca, oleo, useM01) {
        const compX = parseFloat(document.getElementById('f_compX').value);
        const largY = parseFloat(document.getElementById('f_largY').value);
        const numT = parseInt(document.getElementById('f_numT').value);
        const diam = parseFloat(document.getElementById('f_diam').value);
        const rpm = parseInt(document.getElementById('f_rpm').value);
        const avanco = parseInt(document.getElementById('f_avanco').value);

        const zAprox = parseFloat(document.getElementById('f_zAprox').value);
        const zInicial = parseFloat(document.getElementById('f_zInicial').value);
        const zPasse = Math.abs(parseFloat(document.getElementById('f_zPasse').value));
        const zFinal = parseFloat(document.getElementById('f_zFinal').value);

        if (!validarZAproximacao(zAprox, zInicial, "FACEAMENTO")) return null;

        const passoY = diam * 0.6;

        let gcode = `(INICIO-DA-TAREFA-FACEAMENTO)\n`;
        gcode += `${zeroPeca}G90G21G17\n`;
        gcode += `T${numT}M6\n`;
        if (useM01) gcode += `M01\n`;
        gcode += `G43H${numT}G0Z100\n`;
        gcode += `S${rpm}M3\n`;
        gcode += `G52X-${(compX/2).toFixed(2)}Y-${(largY/2).toFixed(2)}\n`;
        gcode += `X-${diam.toFixed(1)}Y0\n`;
        gcode += `Z${(zInicial + 1).toFixed(2)}\n`;

        let zAtual = zInicial;
        let contadorPasse = 1;

        while (zAtual >= zFinal) {
            gcode += `N${contadorPasse}\n`;
            gcode += `G1F${avanco}Y0\n`;
            gcode += `Z${zAtual.toFixed(2)}\n`;
            gcode += `${oleo}\n`;

            let posicaoY = 0.0;
            let direcaoX = true;

            while (posicaoY <= largY) {
                if (direcaoX) {
                    gcode += `X${(compX + diam).toFixed(2)}\n`;
                } else {
                    gcode += `X-${diam.toFixed(2)}\n`;
                }

                posicaoY += passoY;
                if (posicaoY <= largY) {
                    gcode += `Y${posicaoY.toFixed(2)}\n`;
                } else {
                    if ((posicaoY - passoY) < largY) {
                        gcode += `Y${largY.toFixed(2)}\n`;
                        direcaoX = !direcaoX;
                        if (direcaoX) {
                            gcode += `X${(compX + diam).toFixed(2)}\n`;
                        } else {
                            gcode += `X-${diam.toFixed(2)}\n`;
                        }
                    }
                }
                direcaoX = !direcaoX;
            }

            gcode += `G91Z5\n`;
            gcode += `G90\n`;
            gcode += `G0X-${diam.toFixed(2)}Y0\n`;

            if (zAtual === zFinal) break;

            zAtual = zAtual - zPasse;
            if (zAtual < zFinal) zAtual = zFinal;
            contadorPasse++;
        }

        gcode += `G0Z200M9\n`;
        gcode += `M05\n`;
        return gcode;
    }

    function obterBlocoContorno(zeroPeca, oleo, useM01) {
        const compX = parseFloat(document.getElementById('c_compX').value);
        const largY = parseFloat(document.getElementById('c_largY').value);
        const numT = parseInt(document.getElementById('c_numTDesb').value);
        const diam = parseFloat(document.getElementById('c_diamDesb').value);
        const rpm = parseInt(document.getElementById('c_rpmDesb').value);
        const avanco = parseInt(document.getElementById('c_avancoDesb').value);
        const sobremetal = parseFloat(document.getElementById('c_sobremetal').value);

        const execAcab = document.getElementById('c_execAcab').value;
        const numTAcab = parseInt(document.getElementById('c_numTAcab').value);
        const diamAcab = parseFloat(document.getElementById('c_diamAcab').value);
        const rpmAcab = parseInt(document.getElementById('c_rpmAcab').value);
        const avancoAcab = parseInt(document.getElementById('c_avancoAcab').value);

        const zAprox = parseFloat(document.getElementById('c_zAprox').value);
        const zInicial = parseFloat(document.getElementById('c_zInicial').value);
        const zPasse = Math.abs(parseFloat(document.getElementById('c_zPasse').value));
        const zFinalAbs = Math.abs(parseFloat(document.getElementById('c_zFinal').value));

        if (!validarZAproximacao(zAprox, zInicial, "CONTORNO")) return null;

        let gcode = `(INICIO-DA-TAREFA-CONT.)\n`;
        gcode += `T${numT}M6\n`;
        if (useM01) gcode += `M01\n`;
        gcode += `G43H${numT}G0Z150\n`;
        gcode += `S${rpm}M3\n`;
        gcode += `G52X-${(compX/2).toFixed(2)}Y-${(largY/2).toFixed(2)}\n`;
        gcode += `X-${(diam + 10).toFixed(2)}Y-${(diam/2).toFixed(2)}\n`;
        gcode += `Z${(zInicial + 1).toFixed(2)}F${avanco}\n`;
        gcode += `${oleo}\n`;
        gcode += `G1X-${(diam + 10).toFixed(2)}\n`;

        let zAtual = zInicial;

        while (zAtual < zFinalAbs) {
            let zProximo = zAtual + zPasse;
            if (zProximo > zFinalAbs) zProximo = zFinalAbs;

            let dz = (zProximo - zAtual) / 4;

            gcode += `G1Z-${zAtual.toFixed(2)}\n`;
            gcode += `X${(compX + sobremetal + diam/2).toFixed(2)}Z-${(zAtual + dz * 1).toFixed(3)}\n`;
            gcode += `Y${(largY + sobremetal + diam/2).toFixed(2)}Z-${(zAtual + dz * 2).toFixed(3)}\n`;
            gcode += `X-${(sobremetal + diam/2).toFixed(2)}Z-${(zAtual + dz * 3).toFixed(3)}\n`;
            gcode += `Y-${(sobremetal + diam/2).toFixed(2)}Z-${zProximo.toFixed(3)}\n`;

            zAtual = zProximo;
        }

        gcode += `X${(compX + sobremetal + diam/2).toFixed(2)}\n`;
        gcode += `Y${(largY + sobremetal + diam/2).toFixed(2)}\n`;
        gcode += `X-${(sobremetal + diam/2).toFixed(2)}\n`;
        gcode += `Y-${(sobremetal + diam/2).toFixed(2)}\n`;

        gcode += `G0Z150\n`;
        gcode += `M05M9\n\n`;

        if (execAcab === 'SIM') {
            gcode += `(INICIO-DE-TAREFA-ACAB.CONT.)\n`;
            gcode += `T${numTAcab}M6\n`;
            if (useM01) gcode += `M01\n`;
            gcode += `G43H${numTAcab}G0Z150\n`;
            gcode += `S${rpmAcab}M3\n`;
            gcode += `G52X-${(compX/2).toFixed(2)}Y-${(largY/2).toFixed(2)}\n`;
            gcode += `X-${(diamAcab + 10).toFixed(2)}Y-${(diamAcab/2).toFixed(2)}\n`;
            gcode += `Z${(zInicial + 1).toFixed(2)}F${avancoAcab}\n`;
            gcode += `${oleo}\n`;
            gcode += `G1X-${(diamAcab + 10).toFixed(2)}\n`;

            let zAtualAcab = zInicial;
            let zPasseAcab = zPasse / 2;

            while (zAtualAcab < zFinalAbs) {
                let zProximo = zAtualAcab + zPasseAcab;
                if (zProximo > zFinalAbs) zProximo = zFinalAbs;

                let dz = (zProximo - zAtualAcab) / 4;

                gcode += `G1Z-${zAtualAcab.toFixed(2)}\n`;
                gcode += `X${(compX + diamAcab/2).toFixed(2)}Z-${(zAtualAcab + dz * 1).toFixed(3)}\n`;
                gcode += `Y${(largY + diamAcab/2).toFixed(2)}Z-${(zAtualAcab + dz * 2).toFixed(3)}\n`;
                gcode += `X-${(diamAcab/2).toFixed(2)}Z-${(zAtualAcab + dz * 3).toFixed(3)}\n`;
                gcode += `Y-${(diamAcab/2).toFixed(2)}Z-${zProximo.toFixed(3)}\n`;

                zAtualAcab = zProximo;
            }

            gcode += `X${(compX + diamAcab/2).toFixed(2)}\n`;
            gcode += `Y${(largY + diamAcab/2).toFixed(2)}\n`;
            gcode += `X-${(diamAcab/2).toFixed(2)}\n`;
            gcode += `Y-${(diamAcab/2).toFixed(2)}\n`;

            gcode += `G0Z150\n`;
            gcode += `M05M9\n\n`;
        }

        return gcode;
    }

    function obterBlocoMatriz(zeroPeca, oleo, useM01) {
        if (!validarMatriz()) return null;

        const colunas = parseInt(document.getElementById('m_colunas').value);
        const linhas = parseInt(document.getElementById('m_linhas').value);
        const tamX = parseFloat(document.getElementById('m_tamX').value);
        const tamY = parseFloat(document.getElementById('m_tamY').value);
        const canal = parseFloat(document.getElementById('m_canal').value);

        const numT = parseInt(document.getElementById('m_numT').value);
        const diam = parseFloat(document.getElementById('m_diam').value);
        const rpm = parseInt(document.getElementById('m_rpm').value);
        const avanco = parseInt(document.getElementById('m_avanco').value);
        const sobremetal = parseFloat(document.getElementById('m_sobremetal').value);

        const execAcab = document.getElementById('m_execAcab').value;
        const numTAcab = parseInt(document.getElementById('m_numTAcab').value);
        const diamAcab = parseFloat(document.getElementById('m_diamAcab').value);
        const rpmAcab = parseInt(document.getElementById('m_rpmAcab').value);
        const avancoAcab = parseInt(document.getElementById('m_avancoAcab').value);

        const zAprox = parseFloat(document.getElementById('m_zAprox').value);
        const zInicial = parseFloat(document.getElementById('m_zInicial').value);
        const zPasse = Math.abs(parseFloat(document.getElementById('m_zPasse').value));
        const zFinalAbs = Math.abs(parseFloat(document.getElementById('m_zFinal').value));

        if (!validarZAproximacao(zAprox, zInicial, "MATRIZ DE ILHAS")) return null;

        let gcode = `(INICIO-DA-TAREFA-MATRIZ-ILHAS)\n`;
        gcode += `T${numT}M6\n`;
        if (useM01) gcode += `M01\n`;
        gcode += `G43H${numT}G0Z150\n`;
        gcode += `S${rpm}M3\n`;
        gcode += `${oleo}\n`;

        const larguraTotalMatrizX = (colunas * tamX) + ((colunas - 1) * canal);
        const larguraTotalMatrizY = (linhas * tamY) + ((linhas - 1) * canal);

        const centroInicialX = -(larguraTotalMatrizX / 2) + (tamX / 2);
        const centroInicialY = -(larguraTotalMatrizY / 2) + (tamY / 2);

        const passoX = tamX + canal;
        const passoY = tamY + canal;

        for (let l = 0; l < linhas; l++) {
            for (let c = 0; c < colunas; c++) {
                let centroX = centroInicialX + (c * passoX);
                let centroY = centroInicialY + (l * passoY);

                let minX = centroX - (tamX / 2) - sobremetal - (diam / 2);
                let maxX = centroX + (tamX / 2) + sobremetal + (diam / 2);
                let minY = centroY - (tamY / 2) - sobremetal - (diam / 2);
                let maxY = centroY + (tamY / 2) + sobremetal + (diam / 2);

                let entradaX = minX - (diam / 2);
                let entradaY = minY;

                gcode += `G0X${entradaX.toFixed(2)}Y${entradaY.toFixed(2)}\n`;
                gcode += `G0Z${zAprox.toFixed(1)}\n`;

                let zAtual = zInicial;

                while (zAtual < zFinalAbs) {
                    let zProximo = zAtual + zPasse;
                    if (zProximo > zFinalAbs) zProximo = zFinalAbs;

                    let dz = (zProximo - zAtual) / 4;

                    gcode += `G1X${maxX.toFixed(2)}Z-${(zAtual + dz * 1).toFixed(3)}F${avanco}\n`;
                    gcode += `Y${maxY.toFixed(2)}Z-${(zAtual + dz * 2).toFixed(3)}\n`;
                    gcode += `X${minX.toFixed(2)}Z-${(zAtual + dz * 3).toFixed(3)}\n`;
                    gcode += `Y${minY.toFixed(2)}Z-${zProximo.toFixed(3)}\n`;

                    zAtual = zProximo;
                }

                gcode += `X${maxX.toFixed(2)}\n`;
                gcode += `Y${maxY.toFixed(2)}\n`;
                gcode += `X${minX.toFixed(2)}\n`;
                gcode += `Y${minY.toFixed(2)}\n`;

                gcode += `G0Z${zAprox.toFixed(1)}\n`;
            }
        }

        gcode += `G0Z150\n`;
        gcode += `M05M9\n\n`;

        if (execAcab === 'SIM') {
            gcode += `(INICIO-DA-TAREFA-ACAB.MATRIZ)\n`;
            gcode += `T${numTAcab}M6\n`;
            if (useM01) gcode += `M01\n`;
            gcode += `G43H${numTAcab}G0Z150\n`;
            gcode += `S${rpmAcab}M3\n`;
            gcode += `${oleo}\n`;

            for (let l = 0; l < linhas; l++) {
                for (let c = 0; c < colunas; c++) {
                    let centroX = centroInicialX + (c * passoX);
                    let centroY = centroInicialY + (l * passoY);

                    let minX = centroX - (tamX / 2) - (diamAcab / 2);
                    let maxX = centroX + (tamX / 2) + (diamAcab / 2);
                    let minY = centroY - (tamY / 2) - (diamAcab / 2);
                    let maxY = centroY + (tamY / 2) + (diamAcab / 2);

                    let entradaX = minX - (diamAcab / 2);
                    let entradaY = minY;

                    gcode += `G0X${entradaX.toFixed(2)}Y${entradaY.toFixed(2)}\n`;
                    gcode += `G0Z${zAprox.toFixed(1)}\n`;

                    let zAtual = zInicial;
                    let zPasseAcab = zPasse / 2;

                    while (zAtual < zFinalAbs) {
                        let zProximo = zAtual + zPasseAcab;
                        if (zProximo > zFinalAbs) zProximo = zFinalAbs;

                        let dz = (zProximo - zAtual) / 4;

                        gcode += `G1X${maxX.toFixed(2)}Z-${(zAtual + dz * 1).toFixed(3)}F${avancoAcab}\n`;
                        gcode += `Y${maxY.toFixed(2)}Z-${(zAtual + dz * 2).toFixed(3)}\n`;
                        gcode += `X${minX.toFixed(2)}Z-${(zAtual + dz * 3).toFixed(3)}\n`;
                        gcode += `Y${minY.toFixed(2)}Z-${zProximo.toFixed(3)}\n`;

                        zAtual = zProximo;
                    }

                    gcode += `X${maxX.toFixed(2)}\n`;
                    gcode += `Y${maxY.toFixed(2)}\n`;
                    gcode += `X${minX.toFixed(2)}\n`;
                    gcode += `Y${minY.toFixed(2)}\n`;

                    gcode += `G0Z${zAprox.toFixed(1)}\n`;
                }
            }

            gcode += `G0Z150\n`;
            gcode += `M05M9\n\n`;
        }
        return gcode;
    }

    function obterBlocoListaFuros(zeroPeca, oleo, useM01) {
        if (listaFurosCustom.length === 0) {
            alert("Sua lista de furos personalizada está vazia! Adicione furos na Aba 4.");
            return null;
        }

        const zAprox = parseFloat(document.getElementById('lf_zAprox').value);
        const zInicial = parseFloat(document.getElementById('lf_zInicial').value);

        if (!validarZAproximacao(zAprox, zInicial, "LISTA DE FUROS")) return null;

        let gruposBrocas = {};
        listaFurosCustom.forEach(furo => {
            if (!gruposBrocas[furo.t]) {
                gruposBrocas[furo.t] = [];
            }
            gruposBrocas[furo.t].push(furo);
        });

        let gcode = `(INICIO-DA-TAREFA-FURACAO-G83)\n`;

        for (let numT in gruposBrocas) {
            let furosDoGrupo = gruposBrocas[numT];
            let refInfo = furosDoGrupo[0];

            gcode += `T${numT}M6\n`;
            if (useM01) gcode += `M01\n`;
            gcode += `G43H${numT}G0Z150\n`;
            gcode += `S${refInfo.rpm}M3\n`;
            gcode += `${oleo}\n`;

            let primeiro = true;
            furosDoGrupo.forEach(furo => {
                if (primeiro) {
                    gcode += `G0X${furo.x.toFixed(2)}Y${furo.y.toFixed(2)}\n`;
                    gcode += `G0Z${zAprox.toFixed(1)}\n`;
                    gcode += `G83Z-${furo.zFinal.toFixed(2)}R${zAprox.toFixed(1)}Q${furo.qPasse.toFixed(2)}F${furo.avanco}\n`;
                    primeiro = false;
                } else {
                    gcode += `X${furo.x.toFixed(2)}Y${furo.y.toFixed(2)}\n`;
                }
            });

            gcode += `G80\n`;
            gcode += `G0Z150\n`;
            gcode += `M05M9\n\n`;
        }

        return gcode;
    }

    function obterBlocoCavidade(zeroPeca, oleo, useM01) {
        if (!validarCavidade()) return null;

        const dimX = parseFloat(document.getElementById('cav_dimX').value);
        const dimY = parseFloat(document.getElementById('cav_dimY').value);
        const centros = obterCentrosCavidades();

        const execAlivio = document.getElementById('cav_execAlivio').checked;
        const alivioOffX = parseFloat(document.getElementById('cav_alivioOffX').value);
        const alivioOffY = parseFloat(document.getElementById('cav_alivioOffY').value);

        const fresaT = parseInt(document.getElementById('cav_fresaT').value);
        const fresaDiam = parseFloat(document.getElementById('cav_fresaDiam').value);
        const fresaRpm = parseInt(document.getElementById('cav_fresaRpm').value);
        const fresaAvanco = parseInt(document.getElementById('cav_fresaAvanco').value);
        const passoPct = parseFloat(document.getElementById('cav_passoLateral').value);

        const execContorno = document.getElementById('cav_execContornoRaio').checked;
        const acabT = parseInt(document.getElementById('cav_acabT').value);
        const acabDiam = parseFloat(document.getElementById('cav_acabDiam').value);
        const acabRpm = parseInt(document.getElementById('cav_acabRpm').value);
        const acabAvanco = parseInt(document.getElementById('cav_acabAvanco').value);
        const sobremetalParedes = parseFloat(document.getElementById('cav_sobremetalParedes').value);

        const zAprox = parseFloat(document.getElementById('cav_zAprox').value);
        const zInicial = parseFloat(document.getElementById('cav_zInicial').value);
        const zPasse = Math.abs(parseFloat(document.getElementById('cav_zPasse').value));
        const zFinalAbs = Math.abs(parseFloat(document.getElementById('cav_zFinal').value));

        if (!validarZAproximacao(zAprox, zInicial, "CAVIDADE COM ALÍVIO")) return null;

        let gcode = `(INICIO-DA-TAREFA-CAVIDADE-RETA)\n`;

        if (execAlivio) {
            listaBrocasAlivio.forEach((broca) => {
                gcode += `T${broca.t}M6\n`;
                if (useM01) gcode += `M01\n`;
                gcode += `G43H${broca.t}G0Z150\n`;
                gcode += `S${broca.rpm}M3\n`;
                gcode += `${oleo}\n`;

                let primeiroFuro = true;
                centros.forEach(c => {
                    let ptX = c.x + alivioOffX;
                    let ptY = c.y + alivioOffY;

                    if (primeiroFuro) {
                        gcode += `G0X${ptX.toFixed(2)}Y${ptY.toFixed(2)}\n`;
                        gcode += `G0Z${zAprox.toFixed(1)}\n`;
                        gcode += `G83Z-${zFinalAbs.toFixed(2)}R${zAprox.toFixed(1)}Q${broca.q.toFixed(2)}F${broca.avanco}\n`;
                        primeiroFuro = false;
                    } else {
                        gcode += `X${ptX.toFixed(2)}Y${ptY.toFixed(2)}\n`;
                    }
                });

                gcode += `G80\n`;
                gcode += `G0Z150\n`;
                gcode += `M05M9\n\n`;
            });
        }

        gcode += `T${fresaT}M6\n`;
        if (useM01) gcode += `M01\n`;
        gcode += `G43H${fresaT}G0Z150\n`;
        gcode += `S${fresaRpm}M3\n`;
        gcode += `${oleo}\n`;

        let folgaDesbaste = execContorno ? sobremetalParedes : 0.0;
        let passoLatMM = fresaDiam * passoPct;

        centros.forEach((centro) => {
            let centroX = centro.x;
            let centroY = centro.y;
            let pontoMergulhoX = execAlivio ? (centroX + alivioOffX) : centroX;
            let pontoMergulhoY = execAlivio ? (centroY + alivioOffY) : centroY;

            let minBoundaryX = centroX - (dimX / 2) + (fresaDiam / 2) + folgaDesbaste;
            let maxBoundaryX = centroX + (dimX / 2) - (fresaDiam / 2) - folgaDesbaste;
            let minBoundaryY = centroY - (dimY / 2) + (fresaDiam / 2) + folgaDesbaste;
            let maxBoundaryY = centroY + (dimY / 2) - (fresaDiam / 2) - folgaDesbaste;

            let zAtual = zInicial;

            while (zAtual < zFinalAbs) {
                let zProximo = zAtual + zPasse;
                if (zProximo > zFinalAbs) zProximo = zFinalAbs;

                gcode += `G0X${pontoMergulhoX.toFixed(2)}Y${pontoMergulhoY.toFixed(2)}\n`;
                gcode += `G0Z${zAprox.toFixed(1)}\n`;
                gcode += `G1Z-${zProximo.toFixed(2)}F${fresaAvanco}\n`;

                let currMinX = pontoMergulhoX;
                let currMaxX = pontoMergulhoX;
                let currMinY = pontoMergulhoY;
                let currMaxY = pontoMergulhoY;

                let expansaoConcluida = false;

                while (!expansaoConcluida) {
                    currMinX -= passoLatMM;
                    currMaxX += passoLatMM;
                    currMinY -= passoLatMM;
                    currMaxY += passoLatMM;

                    if (currMinX < minBoundaryX) currMinX = minBoundaryX;
                    if (currMaxX > maxBoundaryX) currMaxX = maxBoundaryX;
                    if (currMinY < minBoundaryY) currMinY = minBoundaryY;
                    if (currMaxY > maxBoundaryY) currMaxY = maxBoundaryY;

                    gcode += `G1X${currMaxX.toFixed(2)}Y${currMinY.toFixed(2)}\n`;
                    gcode += `Y${currMaxY.toFixed(2)}\n`;
                    gcode += `X${currMinX.toFixed(2)}\n`;
                    gcode += `Y${currMinY.toFixed(2)}\n`;
                    gcode += `X${currMaxX.toFixed(2)}\n`;

                    if (currMinX === minBoundaryX && currMaxX === maxBoundaryX &&
                        currMinY === minBoundaryY && currMaxY === maxBoundaryY) {
                        expansaoConcluida = true;
                    }
                }

                gcode += `G0Z${zAprox.toFixed(1)}\n`;
                zAtual = zProximo;
            }
        });

        gcode += `G0Z150\n`;
        gcode += `M05M9\n\n`;

        if (execContorno) {
            gcode += `(INICIO-DA-TAREFA-ACAB.CAVIDADE)\n`;
            gcode += `T${acabT}M6\n`;
            if (useM01) gcode += `M01\n`;
            gcode += `G43H${acabT}G0Z150\n`;
            gcode += `S${acabRpm}M3\n`;
            gcode += `${oleo}\n`;

            centros.forEach((centro) => {
                let centroX = centro.x;
                let centroY = centro.y;
                let pontoMergulhoX = execAlivio ? (centroX + alivioOffX) : centroX;
                let pontoMergulhoY = execAlivio ? (centroY + alivioOffY) : centroY;

                let contornoMinX = centroX - (dimX / 2) + (acabDiam / 2);
                let contornoMaxX = centroX + (dimX / 2) - (acabDiam / 2);
                let contornoMinY = centroY - (dimY / 2) + (acabDiam / 2);
                let contornoMaxY = centroY + (dimY / 2) - (acabDiam / 2);

                let zAtual = zInicial;

                while (zAtual < zFinalAbs) {
                    let zProximo = zAtual + zPasse;
                    if (zProximo > zFinalAbs) zProximo = zFinalAbs;

                    gcode += `G0X${pontoMergulhoX.toFixed(2)}Y${pontoMergulhoY.toFixed(2)}\n`;
                    gcode += `G0Z${zAprox.toFixed(1)}\n`;
                    gcode += `G1Z-${zProximo.toFixed(2)}F${acabAvanco}\n`;

                    gcode += `G1X${contornoMaxX.toFixed(2)}Y${contornoMinY.toFixed(2)}\n`;
                    gcode += `Y${contornoMaxY.toFixed(2)}\n`;
                    gcode += `X${contornoMinX.toFixed(2)}\n`;
                    gcode += `Y${contornoMinY.toFixed(2)}\n`;
                    gcode += `X${contornoMaxX.toFixed(2)}\n`;

                    gcode += `G0Z${zAprox.toFixed(1)}\n`;
                    zAtual = zProximo;
                }
            });

            gcode += `G0Z150\n`;
            gcode += `M05M9\n\n`;
        }

        return gcode;
    }

    // --- PROGRAMA COMBINADO INTEGRADO ---
    function gerarProgramaCombinado() {
        const incFace = document.getElementById('chk_faceamento').checked;
        const incCont = document.getElementById('chk_contorno').checked;
        const incMatr = document.getElementById('chk_matriz').checked;
        const incList = document.getElementById('chk_lista_furos').checked;
        const incCav  = document.getElementById('chk_cavidade').checked;

        if (!incFace && !incCont && !incMatr && !incList && !incCav) {
            alert("Selecione pelo menos uma operação para gerar o programa!");
            return;
        }

        const zeroPeca = document.getElementById('multi_zeroPeca').value;
        const oleo = document.getElementById('multi_oleo').value;
        const useM01 = document.getElementById('multi_useM01').checked;

        let gcode = `%\nO9(PROGRAMA.REAL)\n`;
        gcode += `#24=${zeroPeca.replace('G', '')}(PONTO.ZERO)\n\n`;

        if (incFace) {
            let bloco = obterBlocoFaceamento(zeroPeca, oleo, useM01);
            if (bloco === null) return;
            gcode += bloco;
        }

        if (incCont) {
            let bloco = obterBlocoContorno(zeroPeca, oleo, useM01);
            if (bloco === null) return;
            gcode += bloco;
        }

        if (incMatr) {
            let bloco = obterBlocoMatriz(zeroPeca, oleo, useM01);
            if (bloco === null) return;
            gcode += bloco;
        }

        if (incList) {
            let bloco = obterBlocoListaFuros(zeroPeca, oleo, useM01);
            if (bloco === null) return;
            gcode += bloco;
        }

        if (incCav) {
            let bloco = obterBlocoCavidade(zeroPeca, oleo, useM01);
            if (bloco === null) return;
            gcode += bloco;
        }

        gcode += `G53Y0\n`;
        gcode += `M30\n%`;

        document.getElementById('codigoGcode').value = gcode;
        liberarBotoesAcao();
        resetarAnimacaoSimulador();
    }

    function gerarFaceamento() {
        document.getElementById('chk_faceamento').checked = true;
        document.getElementById('chk_contorno').checked = false;
        document.getElementById('chk_matriz').checked = false;
        document.getElementById('chk_lista_furos').checked = false;
        document.getElementById('chk_cavidade').checked = false;
        gerarProgramaCombinado();
